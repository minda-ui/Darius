{
  "permissions": {
    "allow": [
      "Bash(composio execute *)",
      "Bash(composio connections remove *)",
      "Bash(composio link *)"
    ],
    "deny": [
"Bash(composio execute GMAIL_ADD_*)",
"Bash(composio execute GMAIL_BATCH_*)",
"Bash(composio execute GMAIL_CREATE_*)",
"Bash(composio execute GMAIL_DELETE_*)",
"Bash(composio execute GMAIL_FORWARD_*)",
"Bash(composio execute GMAIL_IMPORT_*)",
"Bash(composio execute GMAIL_INSERT_*)",
"Bash(composio execute GMAIL_MODIFY_*)",
"Bash(composio execute GMAIL_MOVE_*)",
"Bash(composio execute GMAIL_PATCH_*)",
"Bash(composio execute GMAIL_REMOVE_*)",
"Bash(composio execute GMAIL_REPLY_*)",
"Bash(composio execute GMAIL_SEND_*)",
"Bash(composio execute GMAIL_STOP_*)",
"Bash(composio execute GMAIL_UNTRASH_*)",
"Bash(composio execute GMAIL_UPDATE_*)",
"Bash(composio execute GMAIL_SETTINGS_*)",
"Bash(composio execute GMAIL_LIST_*)",
"Bash(composio execute GMAIL_SEARCH_*)",
"Bash(composio execute GMAIL_WHO_AM_I*)",
"Bash(composio execute GMAIL_GET_AUTO_*)",
"Bash(composio execute GMAIL_GET_CONTACTS*)",
"Bash(composio execute GMAIL_GET_DRAFT*)",
"Bash(composio execute GMAIL_GET_FILTER*)",
"Bash(composio execute GMAIL_GET_LABEL*)",
"Bash(composio execute GMAIL_GET_LANGUAGE_*)",
"Bash(composio execute GMAIL_GET_PEOPLE*)",
"Bash(composio execute GMAIL_GET_VACATION_*)",
"Bash(composio execute -p *)",
      "Bash(composio execute GOOGLEDRIVE_DELETE_*)",
      "Bash(composio execute GOOGLEDRIVE_GOOGLE_DRIVE_DELETE_FOLDER_OR_FILE_ACTION*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "composio"
  ]
}
